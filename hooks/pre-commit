#!/bin/bash
# Pre-commit hook: runs linting, formatting, type checking, and tests

set -e

echo "Running ruff..."
uv run ruff check shell/

echo "Running ruff format..."
uv run ruff format --check shell/

echo "Running pyright..."
uv run pyright shell/

echo "Running tests..."
uv run pytest tests/ -q

echo "All checks passed!"
